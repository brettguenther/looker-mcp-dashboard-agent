# GCP Configuration (for Gemini Agent runtime)
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_GENAI_USE_VERTEXAI="True"
GEMINI_MODEL="gemini-2.5-flash"

# Looker MCP Server Location
MCP_SERVER_URL="https://<your-mcp-server-location>/mcp"

# Port (Cloud Run uses PORT=8080 by default)
PORT=8001
